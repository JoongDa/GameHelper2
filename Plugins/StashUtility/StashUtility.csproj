<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GameHelper\GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\equipment_affix_tiers.json" Condition="Exists('Data\equipment_affix_tiers.json')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\jewel_mod_ranges.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <GreatMarkerAssets Include="$(MSBuildProjectDirectory)\Assets\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(GreatMarkerAssets)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\Assets" SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(MSBuildProjectDirectory)\Data\equipment_affix_tiers.json')" SourceFiles="$(MSBuildProjectDirectory)\Data\equipment_affix_tiers.json" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\Data" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)$(TargetName)$(TargetExt);$(OutDir)$(TargetName).pdb;" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Data\jewel_mod_ranges.json" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\Data" SkipUnchangedFiles="true" />
  </Target>

</Project>
