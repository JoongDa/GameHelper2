<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GameHelper\GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <None Update="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="ApplyPluginChanges.ps1" LogicalName="PluginUpdater.ApplyPluginChanges.ps1" />
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <_PluginUpdaterFiles Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb;$(OutDir)$(TargetName).deps.json;$(OutDir)LibGit2Sharp.dll;$(OutDir)git2*.dll;$(OutDir)catalog.json" />
      <_PluginUpdaterNativeFiles Include="$(OutDir)runtimes\win-x64\native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginUpdaterFiles)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginUpdaterNativeFiles)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\runtimes\win-x64\native\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
